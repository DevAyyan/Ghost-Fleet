# Copy to .env (ignored by git) or set in the host's dashboard.

# Required: your Global Fishing Watch API token (https://globalfishingwatch.org/our-apis/tokens). Value only, no quotes.
GLOBAL_FISHING_WATCH=

# Optional: which sites may call the API from a browser, comma-separated. Default: any site (the API is public and read-only).
# GHOSTFLEET_CORS=https://your-frontend.vercel.app
