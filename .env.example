# ==============================================================================
# Ghost Fleet X — Environment Configuration Template
# All secrets must remain in backend environment variables and never be committed.
# ==============================================================================

# FastAPI Backend Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
ENVIRONMENT=development

# NASA Earthdata Access (Optional - App falls back to calibrated Arabian Sea demo fixture if omitted)
# Register at: https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password
EARTHDATA_BEARER_TOKEN=your_earthdata_bearer_token

# NASA LAADS DAAC / CMR STAC
NASA_CMR_API_URL=https://cmr.earthdata.nasa.gov/search/granules.json
NASA_LAADS_API_URL=https://ladsweb.modaps.eosdis.nasa.gov/api/v2

# NASA POWER REST API (Meteorological Context)
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Maritime Tracking Data Source (Optional - App falls back to calibrated demo fixture if omitted)
# Register at: https://globalfishingwatch.org/our-apis
GFW_API_KEY=your_gfw_api_key

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
