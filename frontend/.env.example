# Copy to .env.local (ignored by git) or set in the host's dashboard. Vite compiles VITE_* values into the public
# JavaScript at build time, so never put a secret here.

# Address of the API, without a trailing slash. Leave unset when the API is on the same address as the site
# (and locally: `npm run dev` forwards /api to http://127.0.0.1:8000).
VITE_API_BASE=https://your-backend.vercel.app
